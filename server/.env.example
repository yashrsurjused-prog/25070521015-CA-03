# Server port
PORT=5000

# Local MongoDB connection (database name must be smartCampusDB)
MONGODB_URI=mongodb://127.0.0.1:27017/smartCampusDB

# Secret used for signing authentication tokens (replace with a long random value)
JWT_SECRET=replace_with_a_long_random_secret

# Optional comma-separated list of allowed frontend origins.
# Leave unset for local development to allow all origins.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
